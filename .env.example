# Copy to .env and fill in. `.env` is gitignored.
# Generate secrets with:
#   openssl rand -base64 48                  # DJANGO_SECRET_KEY
#   openssl rand -hex 24                     # POSTGRES_PASSWORD (keep it URL-safe)

# --- Django -------------------------------------------------------------------
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=change-me
# Production: https://øl.cer06.no behind the existing reverse proxy. Browsers and the proxy send
# the punycode form of the name (xn--l-4ga.cer06.no). Add the CT's IP to reach it on the LAN.
DJANGO_ALLOWED_HOSTS=xn--l-4ga.cer06.no
# Full origins allowed to POST (CSRF).
DJANGO_CSRF_TRUSTED_ORIGINS=https://xn--l-4ga.cer06.no
# true = cookies only over HTTPS. Set to false only for plain-HTTP testing on the LAN.
DJANGO_SECURE_COOKIES=true

# Public URL of the app, used in links in emails and notifications.
SITE_URL=https://xn--l-4ga.cer06.no
# Proxies in front of Django that append to X-Forwarded-For, used to find the client IP for rate
# limiting: Nginx Proxy Manager + the nginx container = 2. With Cloudflare in front as well: 3.
TRUSTED_PROXY_COUNT=2

# --- Email (Domeneshop SMTP) ------------------------------------------------------
# Used for password reset, "account approved" and new-signup notices to admins. Without
# EMAIL_HOST, emails are only printed to the worker log.
EMAIL_HOST=smtp.domeneshop.no
EMAIL_PORT=587
EMAIL_USE_TLS=true
# EMAIL_USE_SSL=true      # use this with EMAIL_PORT=465 instead of STARTTLS on 587
# The mailbox's username from the Domeneshop control panel (not necessarily the address).
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Must be an address or alias on that Domeneshop mailbox.
DEFAULT_FROM_EMAIL=Drikke Vurderinger <noreply@cer06.no>

# --- Database (docker compose) --------------------------------------------------
POSTGRES_DB=beerrates
POSTGRES_USER=beerrates
POSTGRES_PASSWORD=change-me
# Leave unset for local development to use SQLite (backend/db.sqlite3).
# docker-compose.yml builds DATABASE_URL from the POSTGRES_* values above.

# --- First admin (created on container start if it doesn't exist) ----------------
# The old app's local_admin is imported too (scripts/import-old.sh), with its old password.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=

# --- Web --------------------------------------------------------------------------
# Host port nginx listens on. 3000 is where the old app listened, so the reverse proxy for
# øl.cer06.no needs no change. Restrict it to the reverse proxy with a firewall.
WEB_PORT=3000

# --- Push to the Android app (optional) -----------------------------------------------------
# Web Push (browsers, the iPhone home screen app) works without setup. Push to the Android app
# goes through Firebase: put the service account key in ./secrets/ and uncomment. See the docs:
# Admin → Phone apps.
# FCM_SERVICE_ACCOUNT_FILE=/run/secrets/beer-rates/fcm-service-account.json

# --- Nightly backups (optional) ---------------------------------------------------------
# Add `backup` to COMPOSE_PROFILES (e.g. COMPOSE_PROFILES=docs,backup) to dump the database and
# copy .env to BACKUP_DIR every night (newest BACKUP_KEEP kept), plus a copy of the photos
# (newest BACKUP_MEDIA_KEEP kept; photos are most of the space).
# BACKUP_TIME=03:00
# BACKUP_KEEP=14
# BACKUP_MEDIA_KEEP=3
# BACKUP_DIR=/opt/backup

# --- Documentation (optional) ------------------------------------------------------------
# Uncomment to also build the docs; they're served at /docs/ (øl.cer06.no/docs), so nothing
# changes in the reverse proxy. Combine with backups as COMPOSE_PROFILES=docs,backup.
# COMPOSE_PROFILES=docs
# Password for the encrypted admin pages (at least 12 characters), read when the docs image is built.
# DOCS_ADMIN_PASSWORD=

# --- Tuning (optional) -------------------------------------------------------------------
# Largest photo upload in MB (the apps send photos of well under 1 MB).
# MAX_PHOTO_UPLOAD_MB=15
# Days the online look-up results are cached.
# LOOKUP_CACHE_DAYS=30
# Days an unused app login stays valid.
# API_TOKEN_IDLE_DAYS=180
# Extra origins allowed to call the API (the phone apps' own origins are allowed by default).
# CORS_ALLOWED_ORIGINS=https://localhost,capacitor://localhost,http://localhost
# LOG_LEVEL=INFO
